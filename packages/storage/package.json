{
  "name": "@hookx/storage",
  "version": "0.0.0",
  "private": true,
  "description": "HOOKX PostgreSQL persistence for normalized webhook events",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "drizzle"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli-migrate.ts"
  },
  "dependencies": {
    "@hookx/audit": "workspace:*",
    "@hookx/domain": "workspace:*",
    "@hookx/state-machine": "workspace:*",
    "@hookx/webhook": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@hookx/testkit": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5"
  }
}
