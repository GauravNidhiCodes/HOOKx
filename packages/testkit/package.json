{
  "name": "@hookx/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "HOOKX synthetic fixtures for deterministic tests",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookx/domain": "workspace:*",
    "@hookx/webhook": "workspace:*"
  }
}
