# HOOKX local environment template.
# Copy to .env for machine-local values. Never commit .env.
#
# Do not put live provider credentials here.

HOOKX_API_HOST=127.0.0.1
HOOKX_API_PORT=8787

# PostgreSQL. Replace USER with the local role. Add :PASSWORD only in .env, never here.
HOOKX_DATABASE_URL=postgres://USER@127.0.0.1:5432/hookx
HOOKX_TEST_DATABASE_URL=postgres://USER@127.0.0.1:5432/hookx_test

# Synthetic webhook HMAC secret. Local/dev placeholder only. Never a live PSP key.
HOOKX_SYNTHETIC_WEBHOOK_SECRET=dev-only-not-a-real-secret
HOOKX_SYNTHETIC_WEBHOOK_TOLERANCE_SECONDS=300

# PostgreSQL-backed retry worker. No jitter. Delay = min(max, base * 2^(attempt-1)).
HOOKX_RETRY_MAX_ATTEMPTS=5
HOOKX_RETRY_BASE_DELAY_MS=1000
HOOKX_RETRY_MAX_DELAY_MS=60000
HOOKX_RETRY_LEASE_MS=30000
