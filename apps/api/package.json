{
  "name": "@hookx/api",
  "version": "0.0.0",
  "private": true,
  "description": "HOOKX HTTP API and webhook ingest",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "retry:tick": "tsx src/retry-worker.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hookx/audit": "workspace:*",
    "@hookx/domain": "workspace:*",
    "@hookx/storage": "workspace:*",
    "@hookx/webhook": "workspace:*",
    "@hono/node-server": "^1.19.4",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
